# Architecture Assistant - 基于大模型的软件架构风格智能助手
# 微服务架构: API Gateway → Orchestration Engine → Agent Runtime + LLM Router

# LLM 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Neo4j 可选增强配置
NEO4J_URI=bolt://localhost:7687
# Docker Compose 访问宿主机 Neo4j 时使用；AuraDB 可与 NEO4J_URI 设置为同一地址
NEO4J_DOCKER_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_neo4j_password
NEO4J_RETRY_INTERVAL_SECONDS=30

# 缓存配置
RESPONSE_CACHE_TTL=300
RESPONSE_CACHE_MAX=500

# 日志级别
LOG_LEVEL=INFO
